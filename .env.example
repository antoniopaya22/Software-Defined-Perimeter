# Copy to .env and replace every "change-me" value before starting the lab.
#   cp .env.example .env
# Quick random values:  openssl rand -base64 24

DB_ROOT_PASSWORD=change-me
DB_USER=sdp
DB_PASSWORD=change-me
# Passphrase protecting the SDP CA private key (stays inside the controller)
CA_KEY_PASSWORD=change-me

# Network layout (defaults shown). Change if they clash with your networks.
# PUBLIC_SUBNET=10.231.0.0/24
# PRIVATE_SUBNET=10.231.1.0/24
# CONTROLLER_IP=10.231.0.10
# GATEWAY_IP=10.231.0.20
# GATEWAY_PRIVATE_IP=10.231.1.20
# CLIENT_IP=10.231.0.40
# PROTECTED_SERVICE_IP=10.231.1.30
# Port on the gateway that forwards to the protected service once authorized
# PROTECTED_PORT=8080
